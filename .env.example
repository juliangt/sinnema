# Sinnema — variables de entorno (issue #14).
# Copiar a .env:  cp .env.example .env
#
# Docker Compose lee este archivo completo (env_file) para los servicios.
# Dentro de los contenedores Compose fija por su cuenta: SINNEMA_HOST=0.0.0.0,
# SINNEMA_PORT=8000, SINNEMA_DATA_DIR=/data, SINNEMA_PROJECTS_DIR=/app/proyectos
# y SINNEMA_RELOAD=1 (pisan lo que se declare acá); los valores de SINNEMA_*
# de abajo aplican a la corrida sin Docker.

# ---------------------------------------------------------------------------
# Proveedores LLM: la API levanta igual sin claves (fallan al generar, con
# error accionable). Dejar vacía lo que no se use.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=            # alternativa a GEMINI_API_KEY

# ---------------------------------------------------------------------------
# Ollama local (sin clave). Desde un contenedor, 127.0.0.1 NO alcanza al
# Ollama del host: usar host.docker.internal. Si se levanta el servicio
# `ollama` del compose (docker compose --profile ollama up), usar
# http://ollama:11434.
# ---------------------------------------------------------------------------
# OLLAMA_HOST=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# Overrides de proveedor/modelo por rol (opcional; ejemplos):
# ---------------------------------------------------------------------------
# LLM_PROVIDER_SCRIPTWRITER=ollama
# LLM_MODEL_SCRIPTWRITER=llama3.1

# ---------------------------------------------------------------------------
# Servidor sinnema-server (corrida sin Docker; Docker los fija solo).
# ---------------------------------------------------------------------------
# SINNEMA_HOST=127.0.0.1
# SINNEMA_PORT=8000
# SINNEMA_DATA_DIR=datos-servidor
# SINNEMA_PROJECTS_DIR=proyectos
# SINNEMA_LOG_LEVEL=INFO
# SINNEMA_RELOAD=1
